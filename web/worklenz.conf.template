resolver ${NGINX_LOCAL_RESOLVERS} valid=10s;

server {
    listen ${PORT};
    listen [::]:${PORT};
    server_name _;

    root /usr/share/nginx/html;

    set $worklenz_api "${BACKEND_HOST}:${BACKEND_PORT}";
    set $worklenz_storage "${STORAGE_HOST}:${STORAGE_PORT}";

    location = /healthz {
        access_log off;
        default_type text/plain;
        return 200 "ok\n";
    }

    # Worklenz API, auth, CSRF and link previews.
    location ~ ^/(api|secure|public|webhook|csrf-token)(/|$) {
        include /etc/nginx/proxy_headers.conf;
        proxy_set_header Host $host;
        proxy_read_timeout 120s;
        proxy_pass http://$worklenz_api;
    }

    location ~ ^/worklenz/(t|c|projects)/ {
        include /etc/nginx/proxy_headers.conf;
        proxy_set_header Host $host;
        proxy_pass http://$worklenz_api;
    }

    # Realtime updates (socket.io on /socket).
    location /socket/ {
        include /etc/nginx/proxy_headers.conf;
        proxy_set_header Host $host;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $connection_upgrade;
        proxy_buffering off;
        proxy_read_timeout 1d;
        proxy_send_timeout 1d;
        proxy_pass http://$worklenz_api;
    }

    # File storage (SeaweedFS S3): presigned uploads and downloads, avatars and logos.
    # The Host header must stay the public one, because the S3 signature covers it.
    location /${S3_BUCKET}/ {
        include /etc/nginx/proxy_headers.conf;
        proxy_set_header Host $http_host;
        proxy_request_buffering off;
        proxy_buffering off;
        proxy_send_timeout 300s;
        proxy_read_timeout 300s;
        proxy_pass http://$worklenz_storage;
    }

    location = /env-config.js {
        add_header Cache-Control "no-store";
    }

    location = /index.html {
        add_header Cache-Control "no-cache";
    }

    location ~* ^/(assets|js|fonts|locales)/ {
        expires 30d;
        try_files $uri =404;
    }

    location / {
        try_files $uri /index.html;
    }
}
